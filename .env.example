# Server
NODE_ENV=development
PORT=2567
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Số proxy tin cậy phía trước server (Fly.io: 1, local: 0)
TRUST_PROXY_HOPS=0
# Header chứa IP thật do nền tảng đặt (vd. cf-connecting-ip), để trống nếu không có
CLIENT_IP_HEADER=
# Thư mục bản build client để server phục vụ luôn trang web (Docker đặt sẵn /app/public)
SERVE_CLIENT_DIR=

# Database (dev: docker compose; prod: Neon)
DATABASE_URL=postgresql://chua:chua@localhost:5432/chua?schema=public

# Redis (dev: docker compose; prod: Upstash)
REDIS_URL=redis://localhost:6379

# Nhiều instance game server (production trên Fly): chia sẻ room qua Redis
COLYSEUS_REDIS=false
# FLY_MACHINE_ID do Fly.io tự đặt, không cần khai báo

# Auth — tạo bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-in-production-0123456789

# Email (dev: để trống → email in ra log; production để trống → tắt quên mật khẩu)
MAIL_FROM=Chùa An Lạc <no-reply@localhost>
RESEND_API_KEY=

# Từ cấm bổ sung cho bộ lọc lời nguyện, phân tách bằng dấu phẩy
PROFANITY_EXTRA=
