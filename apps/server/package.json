{
  "name": "@chua/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@chua/shared": "workspace:*",
    "@colyseus/core": "^0.15.57",
    "@colyseus/schema": "^2.0.35",
    "@colyseus/ws-transport": "^0.15.3",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pino": "^9.5.0",
    "prisma": "^6.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
